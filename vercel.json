{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/portal",
      "destination": "/inpatient-criteria-pdf"
    }
  ],
  "headers": [
    {
      "source": "/ed-metrics",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/ed-metrics/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/contact",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/contact.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/what-patients-really-remember-the-swedish-bus-crash-that-changed-how-i-think-about-healthcare",
      "destination": "/blog",
      "permanent": false
    }
  ]
}
